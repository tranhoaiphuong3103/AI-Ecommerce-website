{
  "name": "Virtual Try-On Image Generation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-image",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "generate-image"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "imageId",
              "value": "={{ $json.body.imageId }}"
            },
            {
              "name": "userId",
              "value": "={{ $json.body.userId }}"
            },
            {
              "name": "productId",
              "value": "={{ $json.body.productId }}"
            },
            {
              "name": "productImageUrl",
              "value": "={{ $json.body.productImageUrl }}"
            },
            {
              "name": "modelHeight",
              "value": "={{ $json.body.modelHeight }}"
            },
            {
              "name": "modelWeight",
              "value": "={{ $json.body.modelWeight }}"
            }
          ]
        },
        "options": {}
      },
      "id": "extract-data",
      "name": "Extract Request Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "url": "http://web:3000/api/images/process",
        "authentication": "none",
        "requestMethod": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  imageId: $json.imageId,\n  productImageUrl: $json.productImageUrl,\n  modelHeight: $json.modelHeight,\n  modelWeight: $json.modelWeight,\n  productId: $json.productId\n}) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "generate-image",
      "name": "Generate Image with Replicate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({\n  success: true,\n  message: 'image generation started',\n  imageId: $('Extract Request Data').item.json.imageId\n}) }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [910, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Extract Request Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Request Data": {
      "main": [
        [
          {
            "node": "Generate Image with Replicate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Image with Replicate": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "id": "virtual-tryon-workflow",
  "tags": []
}
