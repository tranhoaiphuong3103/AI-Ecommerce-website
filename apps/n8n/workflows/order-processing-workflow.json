{
  "name": "Order Processing & Notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "order-status",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-order",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "order-status"
    },
    {
      "parameters": {
        "fromEmail": "orders@ecommerce.local",
        "toEmail": "={{ $json.body.customerEmail }}",
        "subject": "=Order {{ $json.body.orderId }} - Status: {{ $json.body.newStatus }}",
        "text": "=Hello {{ $json.body.customerName }},\n\nYour order status has been updated!\n\nOrder ID: {{ $json.body.orderId }}\nPrevious Status: {{ $json.body.previousStatus }}\nNew Status: {{ $json.body.newStatus }}\nTotal Amount: ${{ $json.body.totalAmount }}\nShipping Address: {{ $json.body.shippingAddress }}\n\nThank you for shopping with us!\n\nBest regards,\nVirtual Try-On E-commerce Team",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Order Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [500, 300],
      "credentials": {
        "smtp": {
          "id": "mailhog-smtp",
          "name": "Mailhog SMTP"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Notification sent\" } }}"
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [750, 300]
    }
  ],
  "connections": {
    "Order Webhook": {
      "main": [
        [
          {
            "node": "Send Order Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Order Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "updatedAt": "2026-01-05T00:00:00.000Z",
  "versionId": "2"
}
